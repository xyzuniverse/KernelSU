#!/bin/bash

# Generate 3 random lowercase words (6 letters each)
word1=$(tr -dc 'a-z' </dev/urandom | head -c6)
word2=$(tr -dc 'a-z' </dev/urandom | head -c6)
word3=$(tr -dc 'a-z' </dev/urandom | head -c6)

echo "Generated words:"
echo "me       -> $word1"
echo "weishu   -> $word2"
echo "kernelsu -> $word3"
echo ""

# Rename package directories
find . -depth -type d -name 'me' -exec sh -c 'mv "$1" "$(dirname "$1")/$2"' sh {} "$word1" \;
find . -depth -type d -name 'weishu' -exec sh -c 'mv "$1" "$(dirname "$1")/$2"' sh {} "$word2" \;
find . -depth -type d -name 'kernelsu' -exec sh -c 'mv "$1" "$(dirname "$1")/$2"' sh {} "$word3" \;

# Replace package references inside files
#   dotted  : me.weishu.kernelsu
#   slashed : me/weishu/kernelsu
#   underscored (JNI symbols): me_weishu_kernelsu
find . -type f -exec sed -i \
    -e "s/me\.weishu\.kernelsu/$word1.$word2.$word3/g" \
    -e "s/me\/weishu\/kernelsu/$word1\/$word2\/$word3/g" \
    -e "s/me_weishu_kernelsu/${word1}_${word2}_${word3}/g" {} +

# Append '-spoofed' to managerVersionName
if [ -f "./build.gradle.kts" ]; then
    sed -i 's/= getVersionName()/= getVersionName() + "-spoofed"/' ./build.gradle.kts
fi

echo "Done."
